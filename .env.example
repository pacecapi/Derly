# ───────────────────────────────────────────────────────────
# Variables de entorno — copia este archivo en Vercel
# (Project Settings → Environment Variables) o en un .env local.
# NUNCA subas el .env real al repositorio.
# ───────────────────────────────────────────────────────────

# Stripe — claves desde https://dashboard.stripe.com/apikeys
# Usa las claves de TEST mientras pruebas (empiezan por sk_test_) y las de
# producción (empiezan por sk_live_) cuando salgas a producción.
STRIPE_SECRET_KEY=<TU_CLAVE_SECRETA_DE_STRIPE>

# Secreto del webhook — lo da Stripe al crear el endpoint del webhook
# (Developers → Webhooks → tu endpoint → Signing secret, empieza por whsec_)
STRIPE_WEBHOOK_SECRET=<TU_SECRETO_DE_WEBHOOK>

# Supabase — desde https://app.supabase.com → tu proyecto → Settings → API
SUPABASE_URL=<TU_PROJECT_URL_DE_SUPABASE>
# Usa la SERVICE ROLE key (secreta, solo backend). NO la anon key.
SUPABASE_SERVICE_ROLE_KEY=<TU_SERVICE_ROLE_KEY>

# Resend — desde https://resend.com/api-keys
RESEND_API_KEY=<TU_API_KEY_DE_RESEND>
# Remitente verificado en Resend (debe ser de un dominio verificado)
EMAIL_REMITENTE=Derly <hola@tudominio.com>

# URL pública del sitio (sin barra final). Ej: https://derly.vercel.app
# Se usa para construir las URLs de éxito/cancelación del pago.
SITE_URL=https://tu-dominio.com
